# ---- Database (Postgres) ----
# Vercel Postgres / Neon / Supabase connection string
DATABASE_URL=postgres://user:password@localhost:5432/orderbuds
# Set to "require" in production (Neon/Vercel Postgres need SSL)
PGSSLMODE=disable

# ---- Session / auth ----
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- WhatsApp Cloud API ----
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ---- AI (order parsing / replies) ----
# If unset, the app falls back to a deterministic keyword parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Trial policy ----
TRIAL_DAYS=3

# ---- Cron protection ----
CRON_SECRET=change-me-cron-secret

# ---- Operator / admin panel ----
ADMIN_SECRET=change-me-admin-secret
