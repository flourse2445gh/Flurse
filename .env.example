# ---- Database (Postgres) ----
# Vercel Postgres / Neon / Supabase connection string
DATABASE_URL=postgres://user:password@localhost:5432/budsbox
# Set to "require" in production (Neon/Vercel Postgres need SSL)
PGSSLMODE=disable

# ---- Session / auth ----
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- WhatsApp Cloud API ----
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ---- Embedded Signup (one-click "Connect with Facebook") ----
# Both are public (they ship in the page). Leave either blank and the dashboard
# falls back to the hand-paste Phone number ID + token form.
WHATSAPP_APP_ID=
WHATSAPP_ES_CONFIG_ID=

# ---- AI (order parsing / replies) ----
# If unset, the app falls back to a deterministic keyword parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Owner alerts (email) ----
# A new order emails the shop owner. Without any transport the app still works,
# but the owner is only told on the dashboard, and the app says so on screen.
#
# Two transports are supported, tried in this order:
#   1. Resend, once a domain of yours is verified (set RESEND_API_KEY and a
#      matching EMAIL_FROM). Get a key at https://resend.com.
#   2. Gmail SMTP, which needs no domain at all: Google signs the mail with its
#      own SPF/DKIM, so it reaches any recipient. Set GMAIL_USER and
#      GMAIL_APP_PASSWORD (an App Password, not the account password).
RESEND_API_KEY=
# Verified sender on a domain you own. While this is still onboarding@resend.dev,
# Resend only delivers to the account owner's own address, so Gmail carries mail.
EMAIL_FROM=BudsBox <onboarding@resend.dev>

# Gmail fallback, used until a Resend domain is verified.
# Create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-step verification on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Trial policy ----
TRIAL_DAYS=14

# ---- Cron protection ----
CRON_SECRET=change-me-cron-secret

# ---- Operator / admin panel ----
ADMIN_SECRET=change-me-admin-secret
